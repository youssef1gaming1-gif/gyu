لقابلة لإعادة الاستخدام تقلل المخلفات."],["إيه معنى إعادة الاستخدام؟",["نرمي الحاجة فوراً","نستخدم الشيء مرة تانية بدل رميه","نحرقه","نخلطه بالقمامة"],1,"إعادة الاستخدام بتقلل كمية النفايات."],["إيه التصرف الصحيح مع البطاريات القديمة؟",["نرميها في النهر","نفتحها ونفرغها","نسلمها لنقطة تجميع مخصصة","نحرقها"],2,"البطاريات تحتاج تجميعاً آمناً ومخصصاً."],["إيه اللي يقلل تلوث الهواء؟",["حرق القمامة","تقليل عوادم المركبات","زيادة الدخان","حرق البلاستيك"],1,"تقليل الانبعاثات والحرق يحسن جودة الهواء."],["إيه سبب مهم لتقليل هدر الطعام؟",["لتقليل المخلفات والموارد المهدرة","عشان نشتري أكتر","عشان نرمي أكتر","مفيش سبب"],0,"إنتاج الطعام يستهلك مياه وطاقة وموارد."],["إيه التصرف الصح مع القمامة؟",["نرميها في الشارع","نرميها في النهر","نستخدم سلال القمامة ونفرز القابل للتدوير","نحرقها"],2,"التخلص السليم والفرز يحميان البيئة."],["إزاي نساعد في مواجهة تغير المناخ؟",["نهدر الطاقة","نقلل استهلاك الطاقة وندعم المتجددة","نحرق الوقود بلا داعي","نقطع الأشجار"],1,"ترشيد الطاقة والطاقة المتجددة يقللان الانبعاثات."],["إيه دور كل فرد في حماية البيئة؟",["مفيش دور","ننتظر غيرنا","نبدأ بعادات يومية ونشجع غيرنا","نزود التلوث"],2,"كل شخص يقدر يساهم بعادات بسيطة."],["إيه شعار أبطال البيئة؟",["ارمِها في الشارع","كوكبنا أمانة… نحميه كل يوم","المياه بلا قيمة","الشجر مالوش لازمة"],1,"حماية البيئة مسؤولية يومية مشتركة."]];
let storyIndex=0,qIndex=0,score=0,answered=false,correctCount=0;
let settings={points:10,rate:1,voice:"auto"};
let currentSection='home';
const sectionHistory=[];
function show(id, fromBack=false){
  const valid=['home','story','quiz','games','certificate','settings'];
  if(!valid.includes(id)) return;
  if(!fromBack && id!==currentSection){sectionHistory.push(currentSection);}
  currentSection=id;
  valid.forEach(s=>document.getElementById(s).classList.toggle('hidden',s!==id));
  if(id==='quiz')renderQ();
  if(id==='story')renderStory();
  if(id==='certificate')renderCert();
  window.scrollTo({top:0,behavior:'smooth'});
}
function goBack(){
  const previous=sectionHistory.pop() || 'home';
  show(previous,true);
}
window.addEventListener('keydown',e=>{if(e.key==='Escape' && currentSection!=='home')goBack();});
function renderStory(){document.getElementById('storyContent').innerHTML='<b>'+chapters[storyIndex][0]+'</b><br>'+chapters[storyIndex][1];document.getElementById('storyCount').textContent=(storyIndex+1)+' / 10';}
function storyMove(d){storyIndex=Math.max(0,Math.min(9,storyIndex+d));renderStory();}
let chosenVoice=null;
function refreshVoices(){if(!('speechSynthesis'in window)){toast('المتصفح لا يدعم الصوت');return;}let list=speechSynthesis.getVoices(),sel=document.getElementById('voiceSelect');if(!sel)return;let old=sel.value;sel.innerHTML='<option value="">اختيار تلقائي</option>'+list.map((v,i)=>'<option value="'+i+'">'+v.name+' — '+v.lang+'</option>').join('');if(old)sel.value=old;toast(list.length?'تم تحميل '+list.length+' صوتاً من جهازك':'لم تظهر أصوات بعد؛ انتظر لحظة واضغط تحديث الأصوات');}
function selectVoice(){let i=document.getElementById('voiceSelect').value,vs=speechSynthesis.getVoices();chosenVoice=i===''?null:vs[Number(i)];}
function speak(text){if(!('speechSynthesis'in window)){toast('المتصفح لا يدعم القراءة الصوتية');return;}if(document.getElementById('autoVoice')?.value==='off'){toast('الصوت التلقائي متوقف من الإعدادات');return;}speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(text);let lang=document.getElementById('language')?.value||'ar';u.lang=lang==='ar-EG'?'ar-EG':(lang==='ar'?'ar-EG':lang);u.rate=Number(settings.rate||1);u.volume=Number(document.getElementById('volume')?.value||1);let vs=speechSynthesis.getVoices();if(chosenVoice)u.voice=chosenVoice;else{let v=vs.find(x=>x.lang.toLowerCase()===u.lang.toLowerCase())||vs.find(x=>x.lang.toLowerCase().startsWith(u.lang.split('-')[0].toLowerCase()));if(v)u.voice=v;}u.onerror=()=>toast('تعذر تشغيل الصوت؛ جرّب صوتاً آخر من الإعدادات');speechSynthesis.speak(u);} 

function speakStory(){speak(chapters.map(c=>c[0]+'. '+c[1]).join(' '));}
function stopSpeech(){if('speechSynthesis'in window)speechSynthesis.cancel();}
function renderQ(){if(qIndex>=20){finishQuiz();return;}answered=false;document.getElementById('qCount').textContent='السؤال '+(qIndex+1)+' من 20';document.getElementById('question').textContent=qs[qIndex][0];document.getElementById('score').textContent=score+' نقطة';document.getElementById('quizProgress').style.width=(qIndex/20*100)+'%';document.getElementById('feedback').innerHTML='';document.getElementById('nextQ').disabled=true;document.getElementById('nextQ').textContent=qIndex===19?'إنهاء التحدي 🏆':'السؤال التالي ←';document.getElementById('answers').innerHTML=qs[qIndex][1].map((a,i)=>'<button class="answer" onclick="choose('+i+',this)">'+String.fromCharCode(1571+i)+') '+a+'</button>').join('');}
function choose(i,el){if(answered)return;answered=true;let q=qs[qIndex],ok=i===q[2];document.querySelectorAll('.answer').forEach((b,n)=>{b.disabled=true;if(n===q[2])b.classList.add('correct');});if(ok){el.classList.add('correct');score+=Number(settings.points);correctCount++;document.getElementById('feedback').innerHTML='<div class="feedback good">✓ الاختيار ناجح! إجابة صحيحة — برافو يا بطل! 🎉<br><small>'+q[3]+'</small></div>';celebrate();speak('الاختيار ناجح! برافو يا بطل!');}else{el.classList.add('wrong');document.getElementById('feedback').innerHTML='<div class="feedback bad">✗ مش دي الإجابة الصحيحة. ولا يهمك، نتعلم ونكمل!<br><small>'+q[3]+'</small></div>';speak('حاول مرة تانية في السؤال الجاي.');}document.getElementById('score').textContent=score+' نقطة';document.getElementById('nextQ').disabled=false;updateHome();}
function nextQuestion(){if(!answered)return;qIndex++;renderQ();updateHome();}
function finishQuiz(){document.getElementById('question').textContent='خلصت التحدي! 🎉';document.getElementById('answers').innerHTML='';document.getElementById('feedback').innerHTML='<div class="feedback good">أحسنت يا بطل! نتيجتك '+correctCount+' من 20 — مجموع نقاطك '+score+'.</div>';document.getElementById('nextQ').textContent='شوف شهادتك 🏅';document.getElementById('nextQ').disabled=false;document.getElementById('nextQ').onclick=()=>show('certificate');document.getElementById('quizProgress').style.width='100%';if(correctCount===20)celebrate();updateHome();renderCert();}
function applyWinnerName(){let input=document.getElementById('winnerName');let name=input.value.trim();if(!name){toast('من فضلك اكتب اسم الفائز أولاً');input.focus();return;}document.getElementById('winnerNameOnCertificate').textContent=name;toast('تم إضافة اسم الفائز للشهادة بنجاح 🎉');}
function renderCert(){let done=qIndex>=20;document.getElementById('locked').classList.toggle('hidden',done);document.getElementById('unlocked').classList.toggle('hidden',!done);document.getElementById('certProgress').style.width=(Math.min(qIndex,20)/20*100)+'%';document.getElementById('certProgressText').textContent=Math.min(qIndex,20)+' من 20 سؤال';if(done){document.getElementById('certDate').textContent='تاريخ الإنجاز: '+new Date().toLocaleDateString('ar-EG');let nm=document.getElementById('winnerName').value.trim();if(nm)document.getElementById('winnerNameOnCertificate').textContent=nm;}document.getElementById('certTile').textContent=done?'مفتوحة 🎉 — مبروك!':'مقفولة 🔒 — افتحها بإكمال الأسئلة.';}
function updateHome(){document.getElementById('homeScore').textContent=score+' نقطة';document.getElementById('homeProgress').style.width=(Math.min(qIndex,20)/20*100)+'%';document.getElementById('homeStatus').textContent='أجبت على '+Math.min(qIndex+(answered?1:0),20)+' من 20 سؤال • الإجابات الصحيحة: '+correctCount;renderCert();}
function celebrate(){let box=document.getElementById('confetti');box.innerHTML='';for(let i=0;i<70;i++){let e=document.createElement('i');e.style.left=Math.random()*100+'%';e.style.background=['#ffcb55','#6557e8','#19b8c8','#16a36a','#f06b82'][i%5];e.style.animationDelay=Math.random()*.6+'s';box.appendChild(e);}setTimeout(()=>box.innerHTML='',2800);}
function toast(t){let x=document.getElementById('toast');x.textContent=t;x.classList.remove('hidden');setTimeout(()=>x.classList.add('hidden'),2200);}
function toggleTheme(){document.body.classList.toggle('dark');}
function saveSettings(){settings.points=document.getElementById('points').value;settings.rate=document.getElementById('rate').value;toast('تم حفظ الإعدادات');}
function changeLanguage(){let v=document.getElementById('language').value;let lang=v==='ar-EG'?'ar-EG':v;document.documentElement.lang=lang;document.documentElement.dir=['ar','ar-EG','ur'].includes(v)?'rtl':'ltr';if(window.google&&google.translate){let el=document.querySelector('.goog-te-combo');if(el){el.value=v==='ar-EG'?'ar':v;el.dispatchEvent(new Event('change'));}}toast('تم اختيار اللغة؛ الترجمة الكاملة متاحة من قائمة ترجمة Google بالأسفل.');}
function changeFontSize(){document.body.style.fontSize=document.getElementById('fontSize').value+'px';}
function changeTheme(){document.body.classList.toggle('dark-mode',document.getElementById('theme').value==='dark');}
function applyWinnerName(){let name=document.getElementById('winnerName').value.trim();if(!name){toast('اكتب اسم الفائز أولاً');document.getElementById('winnerName').focus();return;}document.getElementById('winnerNameOnCertificate').textContent=name;toast('تم تحديث الشهادة باسم '+name+' 🎉');}
function downloadCertificate(){let el=document.getElementById('certificateArtwork');if(!el)return; if(window.html2canvas){html2canvas(el,{scale:2,useCORS:true,backgroundColor:null}).then(c=>{let a=document.createElement('a');a.download='شهادة-أبطال-حماية-البيئة.png';a.href=c.toDataURL('image/png');a.click();});}else{toast('للحفظ كصورة اتصل بالإنترنت ثم أعد المحاولة؛ أو استخدم الطباعة واحفظ PDF.');}}

function resetProgress(){if(confirm('متأكد إنك عايز تبدأ من الأول؟')){qIndex=0;score=0;correctCount=0;answered=false;document.getElementById('nextQ').onclick=nextQuestion;updateHome();renderQ();toast('تمت إعادة ضبط التقدم');}}
function playChoice(){let opts=[['لقيت حنفية مياه مفتوحة من غير استخدام. تعمل إيه؟',['أسيبها','أقفلها وأبلغ لو فيها عطل','أزود تدفق المياه'],1],['شوفت مخلفات قابلة للتدوير. تعمل إيه؟',['أخلطها بباقي القمامة','أحرقها','أفرزها في المكان المخصص'],2]];let x=opts[Math.floor(Math.random()*opts.length)];gameQuestion(x[0],x[1],x[2]);}
function trueFalse(){let x=[['إطفاء النور عند مغادرة الفصل بيوفر الكهرباء؟',['صح','غلط'],0],['رمي البلاستيك في النهر طريقة سليمة للتخلص منه؟',['صح','غلط'],1],['زراعة الأشجار والعناية بيها مفيد للبيئة؟',['صح','غلط'],0]][Math.floor(Math.random()*3)];gameQuestion(x[0],x[1],x[2]);}
function memoryGame(){let words=['إعادة التدوير','ترشيد المياه','طاقة شمسية','زراعة الأشجار'];let w=words[Math.floor(Math.random()*words.length)];document.getElementById('gameArea').innerHTML=`<h3>🧩 تحدي الكلمات</h3><p>احفظ الكلمة دي لمدة 3 ثواني:</p><h2 style="text-align:center;color:#5b4bd4">${w}</h2><button class="btn primary" onclick="askMemory('${w}')">جاهز؟ اخفي الكلمة</button>`;}
function askMemory(w){let wrong=['تلوث','إهدار','حرق مخلفات'];document.getElementById('gameArea').innerHTML='<h3>إيه الكلمة اللي ظهرت؟</h3>'+[w,...wrong].sort(()=>Math.random()-.5).map(a=>`<button class="answer" onclick="memoryAnswer(this,'${a}','${w}')">${a}</button>`).join('');}
function memoryAnswer(el,a,w){if(a===w){el.classList.add('correct');toast('ممتاز! ذاكرة قوية 💚');celebrate();}else{el.classList.add('wrong');toast('حاول تاني!');}}
function gameQuestion(q,opts,correct){document.getElementById('gameArea').innerHTML='<h3>'+q+'</h3>'+opts.map((a,i)=>'<button class="answer" onclick="gameAnswer(this,'+i+','+correct+')">'+a+'</button>').join('');}
function gameAnswer(el,i,c){document.querySelectorAll('#gameArea .answer').forEach(b=>b.disabled=true);if(i===c){el.classList.add('correct');toast('الاختيار ناجح! 👏');celebrate();}else{el.classList.add('wrong');toast('فكر تاني… تقدر تعملها!');}}
renderStory();updateHome();renderQ();

