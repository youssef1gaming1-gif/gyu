
:root{--bg:#f4f7ff;--card:#fff;--ink:#18233d;--muted:#68748d;--primary:#6657e8;--cyan:#19b8c8;--gold:#f5b942;--green:#16a36a;--red:#e45868;--shadow:0 14px 40px #24366b18}
*{box-sizing:border-box}body{margin:0;font-family:Tahoma,Arial,sans-serif;background:radial-gradient(circle at 10% 0,#e7e5ff 0,transparent 32%),radial-gradient(circle at 100% 20%,#dffaff 0,transparent 30%),var(--bg);color:var(--ink)}
button,select,input{font:inherit}button{cursor:pointer;border:0}.app{max-width:1200px;margin:auto;padding:18px}.top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}.brand{display:flex;align-items:center;gap:12px}.logo{width:52px;height:52px;border-radius:17px;background:linear-gradient(135deg,var(--primary),#9c65ec);display:grid;place-items:center;color:white;font-size:27px;box-shadow:var(--shadow)}h1,h2,h3,p{margin-top:0}.brand h1{font-size:20px;margin:0}.brand small{color:var(--muted)}.top-actions{display:flex;gap:8px}.iconbtn,.secondary{background:#fff;color:var(--ink);border:1px solid #e8ebf4;padding:10px 14px;border-radius:13px}.hero{display:grid;grid-template-columns:1.35fr .65fr;gap:18px;background:linear-gradient(120deg,#252b65,#6557db 60%,#21b6c7);color:#fff;border-radius:28px;padding:28px;box-shadow:var(--shadow);overflow:hidden;position:relative}.hero:after{content:"✦";position:absolute;font-size:180px;opacity:.09;left:20px;top:-45px}.hero h2{font-size:clamp(25px,4vw,42px);margin:10px 0}.hero p{line-height:1.9;color:#eef0ff;max-width:680px}.profile{background:#ffffff1c;border:1px solid #ffffff38;border-radius:22px;padding:18px;text-align:center;z-index:1}.profile img{width:126px;height:126px;object-fit:cover;border-radius:50%;border:5px solid #fff;box-shadow:0 8px 28px #1115}.profile h3{margin:12px 0 4px}.profile span{font-size:13px;color:#e4e6ff}.btn{padding:13px 19px;border-radius:14px;background:linear-gradient(135deg,#ffcf68,#f5a936);color:#392b0a;font-weight:bold;box-shadow:0 8px 18px #15154a24}.btn.primary{background:linear-gradient(135deg,#7568f2,#5144cf);color:white}.btn.green{background:linear-gradient(135deg,#24c58a,#109766);color:white}.btn.light{background:white;color:#5044bd}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:18px 0}.tile{background:var(--card);border:1px solid #edf0f7;border-radius:20px;padding:19px;box-shadow:var(--shadow);text-align:right;transition:.2s}.tile:hover{transform:translateY(-3px)}.tile .emoji{font-size:29px}.tile h3{margin:10px 0 6px}.tile p{font-size:13px;color:var(--muted);line-height:1.6;margin:0}.section{background:var(--card);border-radius:24px;padding:24px;box-shadow:var(--shadow);margin:18px 0;border:1px solid #edf0f7}.section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.muted{color:var(--muted)}.hidden{display:none!important}.story-list{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.story-card{background:#f7f8ff;border:1px solid #eaecfa;padding:16px;border-radius:16px;line-height:1.9}.story-card b{color:#5548cc}.quizbox{max-width:800px;margin:auto}.progress{height:10px;background:#edf0fa;border-radius:20px;overflow:hidden;margin:15px 0}.progress span{display:block;height:100%;background:linear-gradient(90deg,var(--cyan),var(--primary));width:0;transition:.3s}.answers{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:20px 0}.answer{padding:16px;background:#f5f6fc;border:2px solid transparent;border-radius:15px;text-align:right;line-height:1.6}.answer:hover{border-color:#aaa2ff}.answer.correct{background:#e6fff3;border-color:var(--green);color:#08784b}.answer.wrong{background:#fff0f1;border-color:var(--red);color:#a72d3b}.feedback{padding:14px;border-radius:14px;margin:12px 0;font-weight:bold}.feedback.good{background:#e5fff2;color:#08784b}.feedback.bad{background:#fff0f1;color:#a72d3b}.badge{display:inline-block;background:#fff2cf;color:#8c5c00;padding:6px 10px;border-radius:30px;font-size:12px;font-weight:bold}.settings{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.field{display:flex;flex-direction:column;gap:8px}.field select,.field input{padding:12px;border:1px solid #dfe3ef;border-radius:12px;background:#fff}.certificate{max-width:850px;margin:12px auto;padding:28px;border:12px double #d4a63d;border-radius:10px;background:linear-gradient(135deg,#fffdf4,#fff);text-align:center;position:relative}.certificate h2{font-family:Georgia,serif;color:#8a6417;font-size:34px}.certificate .name{font-size:32px;color:#5144bd;font-weight:bold;margin:22px}.seal{display:inline-grid;place-items:center;width:85px;height:85px;border-radius:50%;border:4px solid #d3a53d;color:#9b741e;font-size:30px;margin:12px}.lock{font-size:60px}.game-options{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.game-options button{padding:20px;border-radius:16px;background:#f2f1ff;color:#4e42bd;font-weight:bold}.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:#18233d;color:white;padding:12px 20px;border-radius:30px;box-shadow:var(--shadow);z-index:20}.confetti{position:fixed;inset:0;pointer-events:none;z-index:30;overflow:hidden}.confetti i{position:absolute;top:-20px;width:10px;height:16px;animation:fall 2.4s linear forwards}@keyframes fall{to{transform:translateY(110vh) rotate(720deg);opacity:.2}}footer{text-align:center;color:var(--muted);padding:24px;font-size:13px}
@media(max-width:800px){.hero{grid-template-columns:1fr}.profile{display:flex;align-items:center;justify-content:center;gap:15px}.profile img{width:85px;height:85px}.grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.app{padding:10px}.top{align-items:flex-start}.brand h1{font-size:16px}.hero{padding:20px}.grid,.story-list,.answers,.settings,.game-options{grid-template-columns:1fr}.section{padding:17px}.top-actions .iconbtn{padding:9px}}
body.dark{--bg:#101629;--card:#1c2740;--ink:#f1f4ff;--muted:#b0bad0;--shadow:0 14px 40px #0004}body.dark .tile,body.dark .section{border-color:#2b3854}body.dark .story-card,body.dark .answer,body.dark .game-options button{background:#26324d;color:#f1f4ff;border-color:#394765}body.dark .field select,body.dark .field input{background:#26324d;color:#fff;border-color:#394765}body.dark .iconbtn,body.dark .secondary{background:#26324d;color:#fff;border-color:#394765}

/* Certificate and advanced settings */
.certificate-landscape{position:relative;width:100%;aspect-ratio:1.645/1;min-height:430px;max-height:760px;margin:18px auto;border:10px ridge #d7a83e;border-radius:22px;overflow:hidden;background-image:linear-gradient(90deg,#fff9e9d9,#fffdf2e8),url(data:image/png;base64,);background-size:cover;background-position:center;box-shadow:0 15px 45px #503b1740;color:#17376e;text-align:center;}
.cert-inner{height:100%;padding:3.2% 8%;display:flex;flex-direction:column;justify-content:center;align-items:center;position:relative}
.cert-topline{font-size:clamp(16px,2.2vw,30px);font-weight:900;color:#187445;text-shadow:0 1px #fff}
.cert-ribbon{margin:1.2% 0;padding:1% 9%;font-size:clamp(23px,4vw,52px);font-weight:900;color:#fff;background:linear-gradient(90deg,#9b5b08,#f6d77c,#a66b0a);border:3px solid #fff0b5;border-radius:16px;text-shadow:0 2px 4px #633b00;box-shadow:0 5px 14px #65400044}
.cert-subtitle{font-size:clamp(14px,1.8vw,24px);font-weight:bold}.cert-recipient{font-size:clamp(25px,4.4vw,58px);font-weight:900;color:#1747a0;margin:1.5% 0;text-shadow:0 2px 0 #fff}.cert-from{font-size:clamp(16px,2.1vw,28px);font-weight:bold;color:#8b2b17}.cert-from strong{color:#1747a0}.cert-message{font-size:clamp(13px,1.6vw,21px);line-height:1.8;font-weight:bold;margin-top:1.2%;color:#26344c}.cert-footer{width:100%;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:2%;font-size:clamp(11px,1.3vw,17px);font-weight:bold;color:#187445}.cert-seal{position:absolute;right:2%;bottom:5%;width:clamp(54px,7vw,90px);height:clamp(54px,7vw,90px);border-radius:50%;background:radial-gradient(circle,#ffeaa2,#bd8120);border:4px double #fff4c5;display:grid;place-content:center;color:#7c4800;font-size:28px;box-shadow:0 3px 10px #0003}.cert-seal small{font-size:10px;font-weight:bold}.cert-controls{display:flex;align-items:end;gap:10px;flex-wrap:wrap;margin:15px 0}.cert-controls label{flex:1;min-width:220px;font-weight:bold}.cert-controls input{display:block;width:100%;margin-top:6px;padding:12px;border:2px solid #d8c58b;border-radius:10px;font-size:18px;text-align:center}.field input[type=range]{width:100%}body.dark-mode{--bg:#111827;--card:#1f2937;--ink:#f3f4f6;--muted:#c0cad9}body.dark-mode .story-card,body.dark-mode .answer{background:#293449;color:#f3f4f6}#google_translate_element{margin-top:12px}.goog-te-gadget{font-family:Tahoma,Arial!important}
@media(max-width:650px){.certificate-landscape{min-height:360px;aspect-ratio:1.1/1}.cert-inner{padding:5% 6%}.cert-seal{right:1%;bottom:2%}}
@media print{@page{size:A4 landscape;margin:8mm}body *{visibility:hidden!important}#certificate,#certificate #unlocked,#certificate .certificate,#certificate .certificate *{visibility:visible!important}#certificate{position:absolute;left:0;top:0;width:100%;margin:0;padding:0;box-shadow:none;border:0}#certificate .back-btn,#certificate .section-head,#certificate .cert-controls,#locked{display:none!important}.certificate-landscape{width:100%;height:180mm;max-height:none;aspect-ratio:auto;-webkit-print-color-adjust:exact;print-color-adjust:exact}}

